# Generate with: openssl rand -hex 32
API_KEY=replace_me_with_a_long_random_string

# Optional: enable server-side Plex tracking
# PLEX_BASE_URL=http://192.168.1.10:32400
# PLEX_TOKEN=your_plex_token
# PLEX_CHANNEL_FROM_STUDIO=true   # use the Plex Studio field as the channel/author

# Optional: poll Home Assistant for media_player entities playing YouTube
# (channel = media_artist, title = media_title). Long-lived access token from
# your HA profile → Security page.
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=your_long_lived_access_token
